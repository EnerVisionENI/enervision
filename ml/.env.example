# --- MinIO (buckets séparés, voir infra/minio/init-buckets.sh) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=ev_admin
MINIO_SECRET_KEY=change_me_avant_le_deploiement

# Un bucket par couche, pas un bucket unique avec des préfixes.
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_AUDIT=audit
MINIO_BUCKET_MANIFESTS=manifests

# Préfixe interne au bucket gold pour la granularité horaire.
# À ajuster une fois la structure réelle confirmée (voir list_gold_keys.py).
MINIO_GOLD_HOURLY_PREFIX=hourly

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=smart-energy-forecast

# --- Entraînement ---
DEFAULT_SITE_ID=site_02
TRAIN_START=2026-08-01
TRAIN_END=2026-08-25
CALIB_START=2026-08-25
CALIB_END=2026-08-29
TEST_START=2026-08-29
TEST_END=2026-09-01

# seuil de promotion : le champion doit rester sous ce MASE pour être promu
MASE_PROMOTION_THRESHOLD=1.0
# couverture cible de l'intervalle conforme (0.10 = intervalle à 90%)
CONFORMAL_ALPHA=0.10
