# ==============================================================================
# Secrets — jamais commités
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
# Outline : config Dex, contient des hash de mots de passe (le .example est versionné)
infra/outline/dex-config.yaml

# ==============================================================================
# Python (api, etl, ml, infra/backup, e2e)
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
uv.lock

# ==============================================================================
# Node (front)
# ==============================================================================
node_modules/
front/dist/
front/.vite/
*.log
npm-debug.log*

# ==============================================================================
# MLflow / artefacts ML
# ==============================================================================
mlruns/
mlartifacts/
ml/mlflow.db
# Rapports générés. Exception : report_data.json est versionné, c'est la seule
# trace des résultats d'entraînement (le CSV source, lui, n'est pas dans le dépôt).
ml/reports/*.json
!ml/reports/report_data.json

# ==============================================================================
# Données locales — rien ne se commite, tout vit dans MinIO
# ==============================================================================
*.parquet
*.jsonl
data/
tmp/
bronze/
ml/data/csv/

# ==============================================================================
# Outillage local / OS
# ==============================================================================
# .vscode/tasks.json est versionné (tâches Docker partagées), le reste non.
.vscode/*
!.vscode/tasks.json
.idea/
.claude/
.DS_Store
Thumbs.db
*.pid
