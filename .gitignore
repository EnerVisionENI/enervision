# Secrets — jamais commités
.env
.env.*
!.env.example
*.pem
*.key
infra/keycloak/realm-export.json
# Certificats Let's Encrypt générés par Traefik (clés privées une fois peuplé)
infra/traefik/acme.json

# Python (api, etl)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
uv.lock

# Node / front
front/node_modules/
front/dist/
front/.vite/
*.log
npm-debug.log*

# Docker
*.pid

# MLflow (artefacts locaux)
mlruns/
mlartifacts/
ml/reports/*.json  # Rapports générés (sauf les .md versionés)

# Data locale — ne jamais commiter de données (tout vit dans MinIO)
*.parquet
*.jsonl
data/
tmp/
bronze/

# Exception : ml/data/csv/ est la seule base d'entraînement des modèles ML
# (gold MinIO réel encore trop creux pour entraîner, voir ml/RAPPORT_ENTRAINEMENT.md) —
# à versionner comme n'importe quel fichier de code, pas une donnée d'exploitation.
!ml/data/
!ml/data/csv/
!ml/data/csv/**

# IDE / OS
# .vscode/tasks.json est versionné (tâches Docker partagées), le reste non.
.vscode/*
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
node_modules/
ml/mlflow.db
.claude/
