# ---------------------------------------------------------------------------
# EnerVision — configuration unique de toute la stack.
# Copier en .env (déjà ignoré par git) et adapter les valeurs.
#
#   cp .env.example .env
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
# Utilisé par le conteneur postgres ET par l'API.
POSTGRES_USER=ev_admin
POSTGRES_PASSWORD=change_me_avant_le_deploiement
POSTGRES_DB=ev_monitoring
# Valeurs pour lancer l'API hors Docker (sur l'hôte). En Compose, le service
# api force POSTGRES_HOST=postgres / POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- API : JWT / auth -----------------------------------------------------
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INGEST_API_KEY=change-me-in-prod
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MinIO ---------------------------------------------------------------
# Identifiants racine MinIO. L'ETL les réutilise comme access/secret key
# (mapping fait dans compose.yaml : MINIO_ACCESS_KEY / MINIO_SECRET_KEY).
MINIO_ROOT_USER=ev_admin
MINIO_ROOT_PASSWORD=change_me_avant_le_deploiement

# Configuration MinIO pour le ML (data.py accès au gold)
# Serveur de déploiement ou local selon contexte.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ev_admin
MINIO_SECRET_KEY=change_me_avant_le_deploiement
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_AUDIT=audit
MINIO_BUCKET_MANIFESTS=manifests
MINIO_GOLD_HOURLY_PREFIX=hourly

# --- ETL (profile "etl") -----------------------------------------------
# Optionnel : surcharge des valeurs par défaut de compose.yaml.
# API_BASE=http://10.105.200.45:8000
# Egalement lue par l'API elle-même (api/routers/sites.py) pour relayer les
# lectures instantanées /sites/{id}/current, même variable et même défaut.
# INTERVALLE_SECONDES=60
# ALERTS_INTERVALLE_SECONDES=300
# ETL_FETCH_WORKERS=16     # quality.py : téléchargements bronze en parallèle (1 = séquentiel)
# Recalcul des agrégats gold, découplé de la collecte (expressions crontab, UTC) :
# à l'heure pour les partitions modifiées, au jour pour le rattrapage de la veille.
# GOLD_CRON_HORAIRE=3 * * * *
# GOLD_CRON_QUOTIDIEN=15 0 * * *
# etl-collect (silver/gold) et etl-alerts écrivent dans Postgres : ils
# réutilisent POSTGRES_* ci-dessus.

# --- Observabilité (profile "observability") --------------------------
# Prometheus + Grafana + node-exporter (hôte) + cAdvisor (conteneurs).
# Sans ces variables, Grafana démarre en admin / admin — à ne PAS laisser
# tel quel si le port 3001 est exposé.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_avant_le_deploiement

# Rôle Postgres en lecture seule de la datasource Grafana : le dashboard
# « EnerVision — Modèles ML » lit predictions_forecast et aggregates_gold_hourly
# directement en SQL, il ne passe pas par Prometheus.
#
# Le rôle est créé/réaligné par infra/postgres/init/07_grafana_readonly.sh. Sur
# un volume Postgres déjà initialisé (le cas du serveur), les scripts d'init ne
# rejouent pas — l'appliquer une fois à la main :
#   docker compose exec postgres sh /docker-entrypoint-initdb.d/07_grafana_readonly.sh
#
# Laissé vide, le rôle n'est pas créé et le dashboard ML reste sans données ;
# le reste de Grafana (hôte, conteneurs) continue de fonctionner.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change_me_avant_le_deploiement

# --- MLflow (profile "mlflow") ----------------------------------------
# Serveur de tracking et Model Registry pour les modèles ML.
# En dev local : sqlite:///ml/mlflow.db
# En prod : http://10.105.200.44:5000 (après déploiement du service mlflow)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=smart-energy-forecast

# --- ML : inférence batch (service ml-predict, profile "mlflow") ------
# Recalcule les prévisions par site et les écrit dans predictions_forecast.
# PREDICT_CRON est calé après GOLD_CRON_HORAIRE (H+3) pour voir les agrégats
# de l'heure écoulée. Le pas des prévisions reste l'heure : les modèles sont
# calendaires (168 créneaux par semaine), pas descendables sous l'heure.
# PREDICT_TZ : fuseau de lecture de l'heure de la semaine, à trancher par
# `python predict.py --check --probe-tz` sur donnée réelle.
PREDICT_CRON=20 * * * *
PREDICT_HORIZON_HOURS=24
PREDICT_CLIMATOLOGY_DAYS=30
PREDICT_TZ=UTC
PREDICT_MODEL_STAGE=Production

# Accès MinIO du registry lu par ml-predict. ML_MINIO_* doit viser le MinIO du
# MÊME hôte que MLFLOW_TRACKING_URI (défini plus haut, une seule fois) : le client
# MLflow télécharge les artefacts directement depuis le bucket, sans relai par le
# serveur. Volontairement distinct de MINIO_ROOT_* (pipeline bronze/silver/gold),
# qui reste local. Les prévisions, elles, sont toujours écrites en base locale.
ML_MINIO_ENDPOINT=http://localhost:9000
ML_MINIO_ACCESS_KEY=ev_admin
ML_MINIO_SECRET_KEY=change_me_avant_le_deploiement

# --- ML : dates et paramètres d'entraînement --------------------------
# Plages temporelles pour split train/calib/test sur le gold réel.
# À adapter selon le volume disponible (voir ml/reports/RAPPORT_ENTRAINEMENT.md).
DEFAULT_SITE_ID=SITE001
TRAIN_START=2025-08-02
TRAIN_END=2026-08-01
CALIB_START=2026-08-01
CALIB_END=2026-08-20
TEST_START=2026-08-20
TEST_END=2026-09-03

# Seuil de promotion : le champion doit rester sous ce MASE pour servir.
MASE_PROMOTION_THRESHOLD=1.0
# Couverture cible de l'intervalle conforme (0.10 = intervalle à 90%).
CONFORMAL_ALPHA=0.10

# --- Synchro audit -> Azure (profile "audit") ------------------------
# Storage Account Azure existant. Deux containers distincts :
#   AZURE_STORAGE_CONTAINER       : bronze/silver/gold — mutable
#   AZURE_STORAGE_CONTAINER_AUDIT : audit/ — Immutable storage (WORM)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_CONTAINER_AUDIT=
# Passphrase de chiffrement rclone crypt, en clair (fichier non versionné).
# Sans elle, les données chiffrées sur Azure sont irrécupérables.
RCLONE_CRYPT_PASSWORD_RAW=
# Fréquence de synchro, en secondes.
SYNC_INTERVAL_SECONDES=900
