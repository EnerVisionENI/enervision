# Copier en front/.env.local (ignoré par git) pour surcharger en dev.
# Toutes les variables exposées au client DOIVENT être préfixées VITE_.

# URL absolue de l'API. Laisser vide en temps normal : le front appelle /api en
# same-origin (proxy vite en dev, proxy Nginx en prod). À ne renseigner que pour
# pointer vers une API distante depuis un dev local.
VITE_API_URL=

# Clé de stockage du JWT dans le localStorage.
VITE_TOKEN_KEY=enervision_token
