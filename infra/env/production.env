# ---------------------------------------------------------------------------
# EnerVision — valeurs de production NON sensibles (versionnées).
#
# Les mots de passe / clés / secrets vivent dans les secrets GitHub Actions
# (POSTGRES_PASSWORD, JWT_SECRET_KEY, INGEST_API_KEY, MINIO_ROOT_PASSWORD,
# MLFLOW_ADMIN_PASSWORD, MLFLOW_FLASK_SERVER_SECRET_KEY, AZURE_STORAGE_KEY,
# RCLONE_CRYPT_PASSWORD_RAW — voir infra/DEPLOYMENT.md).
# Le step "Restore production env file" du workflow concatène ce fichier
# avec ces secrets pour reconstituer le .env racine avant docker compose up.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=ev_admin
POSTGRES_DB=ev_monitoring

# --- API : JWT / auth -----------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://10.105.200.44:3000,http://localhost:5173,http://localhost:3000

# --- MinIO ---------------------------------------------------------------
MINIO_ROOT_USER=ev_admin

# Identité MinIO utilisée par ml-predict pour télécharger les artefacts des modèles
# (le client MLflow lit le bucket en direct, le serveur ne fait pas relai). Distincte de
# MINIO_ROOT_* pour qu'un poste de dev puisse viser un MinIO distant sans déplacer le
# pipeline bronze/silver/gold ; sur le serveur, les deux désignent la même instance.
# Le mot de passe correspondant est injecté par le job deploy depuis les secrets.
ML_MINIO_ACCESS_KEY=ev_admin

# --- ETL (profile "etl") -----------------------------------------------
# Optionnel : décommenter pour surcharger les valeurs par défaut de compose.yaml.
# API_BASE=http://10.105.200.45:8000
# INTERVALLE_SECONDES=60
# ALERTS_INTERVALLE_SECONDES=300
# ETL_FETCH_WORKERS=16     # quality.py : téléchargements bronze en parallèle (1 = séquentiel)
# Recalcul des agrégats gold, découplé de la collecte (expressions crontab, UTC) :
# à l'heure pour les partitions modifiées, au jour pour le rattrapage de la veille.
# GOLD_CRON_HORAIRE=3 * * * *
# GOLD_CRON_QUOTIDIEN=15 0 * * *

# --- Observabilité (profile "observability") --------------------------
# GRAFANA_ADMIN_PASSWORD vit dans les secrets GitHub Actions (voir DEPLOYMENT.md),
# pas ici. Seul l'identifiant non sensible est versionné.
GRAFANA_ADMIN_USER=ev_admin

# --- MLflow : authentification basique (profile "mlflow", EV-064) -----
# MLFLOW_ADMIN_PASSWORD vit dans les secrets GitHub Actions. MLFLOW_TRACKING_USERNAME
# est le compte que le client mlflow (ml-predict, scripts) utilise pour s'authentifier —
# même identifiant que l'admin pour l'instant, un seul compte pour tout.
MLFLOW_ADMIN_USER=ev_admin
MLFLOW_TRACKING_USERNAME=ev_admin

# --- ML : inférence batch (service ml-predict, profile "mlflow") ------
# Optionnel : décommenter pour surcharger les valeurs par défaut de compose.yaml.
# PREDICT_CRON=20 * * * *          # après le recalcul gold horaire (H+3)
# PREDICT_HORIZON_HOURS=24
# PREDICT_CLIMATOLOGY_DAYS=30
# PREDICT_TZ=UTC                   # à trancher par `predict.py --check --probe-tz`
# PREDICT_MODEL_STAGE=Production

# --- Synchro audit -> Azure (profile "audit") ------------------------
AZURE_STORAGE_ACCOUNT=stgg1smartaudit2026
AZURE_STORAGE_CONTAINER=enervision-backup
AZURE_STORAGE_CONTAINER_AUDIT=enervision-audit
SYNC_INTERVAL_SECONDES=900
