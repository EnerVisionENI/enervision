# ---------------------------------------------------------------------------
# Outline — configuration de la stack isolée (infra/outline/compose.yaml).
# Copier en .env (ignoré par git) et adapter.
#
#   cd infra/outline
#   cp .env.example .env
#   cp dex-config.example.yaml dex-config.yaml
#   docker compose up -d
# ---------------------------------------------------------------------------

# --- Versions des images ----------------------------------------------
# Dernières stables : https://github.com/outline/outline/releases
#                     https://github.com/dexidp/dex/releases
OUTLINE_VERSION=1.10.0
OUTLINE_DEX_VERSION=v2.45.1

# --- Exposition ---------------------------------------------------------
OUTLINE_PORT=3002
OUTLINE_DEX_PORT=5556
# URL publique EXACTE d'Outline (celle tapée dans le navigateur). Sans slash final.
#   local            : http://localhost:3002
#   serveur interne  : http://10.105.200.44:3002
#   domaine + proxy  : https://docs.mondomaine.fr
OUTLINE_URL=http://localhost:3002
# true UNIQUEMENT si un proxy TLS termine le HTTPS en amont (OUTLINE_URL en https).
OUTLINE_FORCE_HTTPS=false

# --- Secrets (obligatoires) -------------------------------------------
# Générer chacun avec :  openssl rand -hex 32
OUTLINE_SECRET_KEY=
OUTLINE_UTILS_SECRET=

# --- Base de données interne ----------------------------------------
OUTLINE_DB_PASSWORD=change_me_avant_le_deploiement

# --- Authentification : OIDC vers Dex (auto-hébergé, aucun appel externe) ---
# OUTLINE_OIDC_ISSUER : identique à `issuer:` dans dex-config.yaml, et joignable
# à la fois par le navigateur ET par le conteneur outline -> IP/port de l'hôte.
#   local   : http://localhost:5556/dex
#   serveur : http://10.105.200.44:5556/dex
OUTLINE_OIDC_ISSUER=http://localhost:5556/dex
OUTLINE_OIDC_CLIENT_ID=outline
# Identique au `secret:` du staticClient "outline" dans dex-config.yaml.
# Générer avec : openssl rand -hex 32
OUTLINE_OIDC_CLIENT_SECRET=
OUTLINE_OIDC_DISPLAY_NAME=Compte EnerVision

# --- SMTP : OPTIONNEL (notifications e-mail uniquement) --------------
# Inutile pour se connecter. Laisser vide pour un fonctionnement hors-ligne.
OUTLINE_SMTP_HOST=
OUTLINE_SMTP_PORT=587
OUTLINE_SMTP_USERNAME=
OUTLINE_SMTP_PASSWORD=
OUTLINE_SMTP_FROM_EMAIL=
OUTLINE_SMTP_SECURE=false
