# Identifiants MinIO (source) — doivent correspondre à infra/minio/.env
MINIO_ROOT_USER=ev_admin
MINIO_ROOT_PASSWORD=change_me_avant_le_deploiement

# Azure Blob Storage (destination) — Storage Account existant.
# Deux containers distincts, pour ne pas verrouiller bronze/silver/gold en même temps que audit :
#   AZURE_STORAGE_CONTAINER       : bronze/, silver/, gold/ — mutable, purgeable
#   AZURE_STORAGE_CONTAINER_AUDIT : audit/ — à configurer en Immutable storage (rétention temporelle)
#                                    dans le Portail Azure, pour reproduire le WORM déjà en place sur MinIO
# Contenu chiffré (fichiers ET noms de fichiers illisibles depuis Azure sans rclone + la passphrase).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_CONTAINER_AUDIT=

# Passphrase de chiffrement rclone crypt, en clair ici (fichier non versionné).
# Sans elle, les données chiffrées sur Azure sont irrécupérables, même par vous.
# Sauvegardez-la aussi dans un gestionnaire de mots de passe séparé.
RCLONE_CRYPT_PASSWORD_RAW=

# Fréquence de synchro, en secondes
SYNC_INTERVAL_SECONDES=900
